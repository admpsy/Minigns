<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Fundo escuro desde o primeiro frame: elimina o "flash branco" ao abrir o jogo -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/crypts_background</item>
        <item name="android:colorBackground">@color/crypts_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23" xmlns:tools="http://schemas.android.com/tools">false</item>
    </style>
</resources>
